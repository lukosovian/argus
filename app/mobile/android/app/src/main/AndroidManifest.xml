<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Y13: başka bir uygulamada Paylaş › ARGUS (Netflix / IMDb / TMDB bağlantısı ya da yapımın adı) -->
            <intent-filter android:label="@string/paylas_etiket">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- argus://… : kısayollar (Y15), ana ekran kutusu (Y11), bildirimler ve PC'deki eşleştirme kare kodu (A8 —
                 telefonun kendi kamerasıyla okutulunca da ARGUS açılır) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="argus" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Y11: ana ekran kutusu "Sıradaki bölüm" -->
        <receiver android:name=".SiradakiWidget" android:exported="false" android:label="@string/widget_baslik">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_siradaki" />
        </receiver>

        <!-- A8: Google'ın kare kod okuyucusu uygulama kurulurken indirilsin (ilk okutmada beklemesin) -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Y14: bilet fotoğrafı için dosya seçicide "Kamera" — Android 11+ kamera uygulamasını ancak bu bildirimle görür -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Güncellemeyi kendi içinde kurabilmek için (bkz. ArgusPlugin.installUpdate) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- H3: PC'ye giden istekleri Wi-Fi ağına bağlamak için ağları görebilmek (bkz. WifiAg) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- H18: Android 17+ ev ağı izni. Uygulama API 36'yı hedeflediği sürece Android kendiliğinden verir; hedef 37'ye
         çıkınca ilk açılışta sorulur (bkz. ArgusPlugin.localNetworkPermission) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Y12/Y25: telefon bildirimleri (Android 13+ sorulur); G4 güncelleme bildirimi -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Titreşim (oyunlar, ödüller: navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Y14: bilet fotoğrafını kamerayla çekmek (dosya seçici kamerayı açarken sorulur) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Y24: parmak izi / yüz ile kilitli profili açma -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
