<?xml version="1.0" encoding="utf-8"?>
<!-- Y11: ana ekran kutusu "Sıradaki bölüm" (bkz. SiradakiWidget.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_baslik"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFA3A3A3"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/w_row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
        <ImageView android:id="@+id/w_img0" android:layout_width="34dp" android:layout_height="50dp" android:scaleType="centerCrop" android:src="@drawable/widget_poster_bos" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF5F5F5" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_sub0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FF00C0FA" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
        <ImageView android:id="@+id/w_img1" android:layout_width="34dp" android:layout_height="50dp" android:scaleType="centerCrop" android:src="@drawable/widget_poster_bos" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF5F5F5" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_sub1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FF00C0FA" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
        <ImageView android:id="@+id/w_img2" android:layout_width="34dp" android:layout_height="50dp" android:scaleType="centerCrop" android:src="@drawable/widget_poster_bos" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF5F5F5" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_sub2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FF00C0FA" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
