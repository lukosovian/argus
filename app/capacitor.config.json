{
  "appId": "com.argus.mobil",
  "appName": "ARGUS",
  "webDir": "dist",
  "android": {
    "path": "mobile/android",
    "allowMixedContent": true,
    "backgroundColor": "#0a0a0a"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  },
  "loggingBehavior": "none"
}
